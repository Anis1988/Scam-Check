{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "functions": {
    "api/ai.ts": {
      "maxDuration": 300
    },
    "api/video.ts": {
      "maxDuration": 300
    },
    "api/company.ts": {
      "maxDuration": 300
    },
    "api/doc.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/summary",
      "destination": "/api/status?summary=1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(self), camera=(self)"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "android": false
    }
  }
}
