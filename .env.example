# Copy this file to .env.local and fill it in (.env.local is never committed).
APP_ACCESS_TOKEN=pick-any-long-password
ANTHROPIC_API_KEY=
# Optional
AI_DAILY_LIMIT=5
GOOGLE_SAFE_BROWSING_KEY=
# Optional: your Upstash Redis (same as on Vercel). Empty = a local file (.local/store.json) is used.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional, free: Google Gemini (Settings → AI → Gemini). From aistudio.google.com → Get API key.
GEMINI_API_KEY=
# Optional, free: more AIs (Settings → AI model).
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
